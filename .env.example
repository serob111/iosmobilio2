# Host-side ports for docker-compose's postgres/redis containers. Defaults match what
# this dev machine needed (5432/6379 were already taken by other local services) — override
# here if your machine is different. Copy to `.env` at the repo root; docker compose loads
# it automatically. Internal container-to-container traffic is unaffected by these values.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
