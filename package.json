{
  "name": "mobilio",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run build --workspace=@mobilio/config && npm run build --workspace=@mobilio/db && npm run build --workspace=@mobilio/storage",
    "build:config": "npm run build --workspace=@mobilio/config",
    "build:db": "npm run build --workspace=@mobilio/db",
    "test:config": "npm test --workspace=@mobilio/config",
    "typecheck:config": "npm run typecheck --workspace=@mobilio/config",
    "typecheck:shell": "npm run typecheck --workspace=mobilio-shell",
    "shell": "npm run start --workspace=mobilio-shell",
    "dev": "docker compose up -d postgres redis minio && concurrently -n web,api,worker -c blue,green,yellow \"npm run dev --workspace=mobilio-web\" \"npm run dev --workspace=mobilio-api\" \"npm run dev --workspace=mobilio-worker\"",
    "dev:infra": "docker compose up -d postgres redis minio",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.71.2"
  },
  "overrides": {
    "typescript": "^5.6.3"
  }
}
