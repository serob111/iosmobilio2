REDIS_URL=redis://localhost:6380

# mobilio_app role — the worker deletes expired drafts (packages/db's drafts table) and
# their icon objects on a schedule. See apps/api/.env.example for the DATABASE_URL shape.
DATABASE_URL=postgres://mobilio_app:mobilio_app_pw@localhost:5433/mobilio

# Same S3-compatible object storage as apps/api (see apps/api/.env.example) — needed to
# delete a draft's icon object alongside its row when it expires.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=mobilio
S3_ACCESS_KEY_ID=mobilio
S3_SECRET_ACCESS_KEY=mobilio_minio_pw
S3_REGION=auto
S3_FORCE_PATH_STYLE=true

# Optional — leave unset to disable Sentry entirely (no-op).
SENTRY_DSN=
