REDIS_URL=redis://localhost:6380

# mobilio_app role — the worker deletes expired drafts (packages/db's drafts table) and
# their icon objects on a schedule. See apps/api/.env.example for the DATABASE_URL shape.
DATABASE_URL=postgres://mobilio_app:mobilio_app_pw@localhost:5433/mobilio

# Same S3-compatible object storage as apps/api (see apps/api/.env.example) — needed to
# delete a draft's icon object alongside its row when it expires.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=mobilio
S3_ACCESS_KEY_ID=mobilio
S3_SECRET_ACCESS_KEY=mobilio_minio_pw
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
# Only matters for a signed download URL, which this worker never generates (it only
# deletes objects) — createObjectStorageFromEnv() still reads it, defaulting to
# S3_ENDPOINT above if unset, so it's effectively a no-op here. Kept for consistency
# with apps/api/.env.example, which documents the same shared object-storage config.
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Optional — leave unset to disable Sentry entirely (no-op).
SENTRY_DSN=

# --- App Store Connect API + code signing + repack (phase 4/5 — repack builds) ----
# REPACK_ENABLED actually gates all of this (index.ts) — "false"/unset (the default)
# means this worker process never touches any of the vars below, never constructs the
# second repack-queue Worker, and loadRepackJobConfig() is never even called. A dev/CI
# environment that never sets REPACK_ENABLED=true doesn't need to configure anything
# past this line at all.
REPACK_ENABLED=false

# How many repack jobs this worker processes in parallel — its own queue/Worker,
# independent of the lightweight cleanup/ping jobs above (see index.ts's own comment on
# why BullMQ's concurrency needs a separate queue to be tunable per job type). Repack is
# CPU/IO-heavy (icon generation, re-signing, re-zipping an .ipa), so keep this modest
# unless the worker's host has real headroom. Defaults to 1 if unset.
REPACK_CONCURRENCY=1

# Local disk cache directory for the active shell_releases base.ipa, keyed by its own
# sha256 (see base-ipa-cache.ts) — every repack build of the same base version reuses
# this instead of re-downloading from S3. Defaults to /tmp/mobilio-repack-cache if unset;
# point this at a persistent volume in production so the cache survives a restart.
REPACK_CACHE_DIR=/tmp/mobilio-repack-cache

# The pinned rcodesign (apple-codesign) binary this worker signs every repacked .ipa
# with, plus its own sha256 — checked before every single signing/verify call (see
# packages/repacker's sign.ts), not just once at startup, so a binary swapped
# mid-deployment is caught immediately. Bake the binary into this worker's own Docker
# image at a fixed path rather than fetching it at runtime.
RCODESIGN_PATH=
RCODESIGN_SHA256=

# App Store Connect API key (Users and Access > Integrations > App Store Connect API
# in App Store Connect). Issuer ID is shown on that same page.
ASC_ISSUER_ID=
ASC_KEY_ID=
# PEM contents of the .p8 file App Store Connect gives you when you create the key —
# either real newlines or literal "\n" both work (validateAppleEnv normalizes either
# form). Never commit a real value here or anywhere else in this repo.
ASC_PRIVATE_KEY=

# Distribution certificate used to re-sign every repacked .ipa — base64-encoded .p12
# bytes (e.g. `base64 -i cert.p12`) and its export password. Decrypted to a 0600 temp
# file only for the duration of a single signing operation (@mobilio/apple's
# withP12FromBase64) and deleted immediately after — never written anywhere else, never
# logged.
SIGNING_P12_BASE64=
SIGNING_P12_PASSWORD=

# The ASC certificates resource id matching SIGNING_P12_BASE64's own certificate
# (ensureAdHocProfile's certificateId), and our one shared Apple Developer Team ID — not
# secret (already visible inside every signed .ipa's own entitlements), same value as
# apps/web's NEXT_PUBLIC_APPLE_TEAM_ID, just the server-side copy.
ASC_DISTRIBUTION_CERT_ID=
APPLE_TEAM_ID=

# AES-256-GCM key (openssl rand -base64 32) encrypting cached Ad Hoc provisioning
# profiles at rest (provisioning_profiles.profile_content_enc) — its own dedicated key,
# never BUILD_TOKEN_KEY/PREVIEW_SLUG_KEY. See provisioning-profile-crypto.ts.
PROVISIONING_PROFILE_KEY=
