# Public URL this server is reachable at — GitHub Actions needs to be able to download
# config/icon from it and upload the built .ipa back to it (see README for cloudflared).
PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com

# Fine-grained GitHub token with "Actions: read and write" on this repo.
GITHUB_TOKEN=github_pat_xxx

# owner/repo of this project on GitHub.
GITHUB_REPO=serob111/iosmobilio2

# Branch the build-ipa.yml workflow runs from.
GITHUB_REF=main

# Shared secret the workflow sends as `x-build-secret` when calling back into this
# server (build-config/build-icon downloads, ipa/failed uploads). Generate any random
# string, e.g. `openssl rand -hex 32`.
BUILD_SECRET=change-me

# Optional — leave unset to disable Sentry entirely (no-op). Server-side errors use
# SENTRY_DSN; client-side (browser) errors need the NEXT_PUBLIC_ prefix to reach the
# browser bundle — same DSN value works for both.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
