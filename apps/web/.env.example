# Optional — leave unset to disable Sentry entirely (no-op). Server-side errors use
# SENTRY_DSN; client-side (browser) errors need the NEXT_PUBLIC_ prefix to reach the
# browser bundle — same DSN value works for both.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# apps/api's own origin — the browser calls it directly (not through this server), so
# the session cookie Better Auth sets is scoped to that origin. Must match apps/api's
# WEB_ORIGIN/CORS config and its own API_BASE_URL (see apps/api/.env.example).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3011

# Shown on the preview shell's "Сообщить о нарушении" link (mailto:). Public by design —
# it's meant to be visible to anyone viewing a preview.
NEXT_PUBLIC_ABUSE_EMAIL=abuse@mobilio.app

# Shows the "Build .ipa" block in the project editor (components/editor/BuildsBlock.tsx).
# Off by default — until the app ships through Ad Hoc/TestFlight, an unsigned .ipa is
# useless to a client, so this would just be confusing surface area. Set to "true" to
# turn it on; any other value (including unset) keeps it off.
NEXT_PUBLIC_ENABLE_BUILDS=false

# The Apple Developer Team ID our App Store Connect account signs every client build
# under (same account for all clients — see packages/apple). Used only to render the
# apple-app-site-association file content next to the editor's Deep Links toggle
# (components/editor/AppleAppSiteAssociation.tsx) — the appID a universal link checks is
# "<team id>.<bundle id>", and a Team ID isn't secret (it's already visible inside every
# signed .ipa's own entitlements). Leave unset to hide that block entirely.
NEXT_PUBLIC_APPLE_TEAM_ID=
