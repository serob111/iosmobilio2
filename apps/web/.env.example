# Optional — leave unset to disable Sentry entirely (no-op). Server-side errors use
# SENTRY_DSN; client-side (browser) errors need the NEXT_PUBLIC_ prefix to reach the
# browser bundle — same DSN value works for both.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# apps/api's own origin — the browser calls it directly (not through this server), so
# the session cookie Better Auth sets is scoped to that origin. Must match apps/api's
# WEB_ORIGIN/CORS config and its own API_BASE_URL (see apps/api/.env.example).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3011

# Shown on the preview shell's "Сообщить о нарушении" link (mailto:). Public by design —
# it's meant to be visible to anyone viewing a preview.
NEXT_PUBLIC_ABUSE_EMAIL=abuse@mobilio.app
