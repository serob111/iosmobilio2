# Points at the host-exposed ports from `docker compose up -d postgres redis` when running
# api natively (npm run dev). Inside docker-compose itself, api uses the internal
# postgres/redis hostnames instead (see docker-compose.yml) — this file is for local dev only.
#
# The mobilio_app role, not the cluster superuser — api runs all queries as this role
# (NOBYPASSRLS, DML-only) so Postgres enforces tenant isolation even if application code
# has a bug. Requires migrations to have been run first (see packages/db/.env.example +
# `npm run db:migrate --workspace=@mobilio/db`), which is what actually creates this role.
DATABASE_URL=postgres://mobilio_app:mobilio_app_pw@localhost:5433/mobilio
REDIS_URL=redis://localhost:6380

# How many reverse-proxy hops to trust X-Forwarded-For through when resolving a client's
# real IP (used by the drafts creation rate limit) — 0 means trust nothing, so a client
# can't just send a different X-Forwarded-For on every request and dodge the limit.
# Running natively like this file assumes, there's no proxy in front, so 0 is correct.
# In prod, behind Caddy, this must be 1 (exactly one hop — Caddy itself).
TRUST_PROXY_HOPS=0

# The drafts claim-token cookie defaults to Secure (HTTPS-only) even here — set this to
# "false" only for local dev over plain http (this machine's native setup, see README).
# Never set it to false in prod: a non-Secure cookie can leak over plain HTTP.
COOKIE_SECURE=false
# Not 3000/3001 — this machine runs other, unrelated projects that occupy that range,
# and Next.js's automatic port fallback (when 3000 is taken) lands on 3001, which used
# to collide with this value.
PORT=3011

# Optional — leave unset to disable Sentry entirely (no-op).
SENTRY_DSN=

# Signs session cookies/tokens — Better Auth requires this. Generate a real one for
# anything beyond local dev, e.g. `openssl rand -hex 32`.
BETTER_AUTH_SECRET=dev-only-not-a-real-secret

# Where this api itself is reachable — used to build magic-link URLs and as the OAuth
# redirect base.
API_BASE_URL=http://localhost:3011

# apps/web's origin — Better Auth validates the Origin header against this list
# (CSRF protection) and sets cookies accordingly. Also the value the preview proxy's
# own Content-Security-Policy (frame-ancestors) and the host-routing split in
# create-app.ts are anchored to.
WEB_ORIGIN=http://localhost:3000

# Where the preview proxy (GET/HEAD /s/:slug/*) answers — MUST be a different
# registrable domain from WEB_ORIGIN above (validatePreviewEnv refuses to start
# otherwise, PSL-aware via tldts — a subdomain of the same site is not enough).
# Browsers scope cookies/same-site by registrable domain, not by subdomain or port, so
# this is the actual mechanism that keeps a proxied third-party site's cookies/framing
# from ever mixing with this app's own session. create-app.ts's host-routing split
# answers /s/:slug/* only when the request's Host matches this value's hostname, and
# 404s every other route there — so this also needs to be the literal public hostname
# this api is reachable at for preview traffic, not just any placeholder.
# Local dev: "http://localhost:3011" won't work (same host as WEB_ORIGIN's default) —
# use a different hostname that still resolves to this machine, e.g. a *.localtest.me
# subdomain (public DNS, always resolves to 127.0.0.1) on the same port.
PREVIEW_PROXY_ORIGIN=http://preview.localtest.me:3011

# Google OAuth — leave both unset to disable the Google sign-in provider entirely.
# https://console.cloud.google.com/apis/credentials, redirect URI:
# ${API_BASE_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend API key for sending real magic-link emails — leave unset to log them instead
# (see src/mail/log-mail-sender.ts), which is enough for local dev/CI.
RESEND_API_KEY=
MAIL_FROM=Mobilio <noreply@mobilio.app>

# Object storage (project icons, .ipa builds) — an S3-compatible endpoint. Locally/CI
# this is MinIO (see docker-compose.yml); in prod it's Cloudflare R2. R2's endpoint is
# https://<account_id>.r2.cloudflarestorage.com, region is "auto", and
# S3_FORCE_PATH_STYLE should be unset/false there (MinIO needs path-style, R2 doesn't).
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=mobilio
S3_ACCESS_KEY_ID=mobilio
S3_SECRET_ACCESS_KEY=mobilio_minio_pw
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
# The host a signed download URL points at — only differs from S3_ENDPOINT when api
# itself runs inside docker-compose (where S3_ENDPOINT is the internal `http://minio:9000`,
# unreachable from a browser). Running api natively like this file assumes, they're the
# same, so this line is redundant but kept explicit rather than silently relying on the
# S3_ENDPOINT fallback.
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Builds (POST /orgs/:orgId/projects/:projectId/builds) — which BuildRunner dispatches
# the actual build. "github" calls the real GitHub Actions workflow below; "fake" uses
# FakeRunner (records the dispatch instead of acting on it) — used by tests and useful
# for local dev when you don't want every build to actually fire off a workflow run.
BUILD_RUNNER=github

# Where the build runner (GitHub Actions today) calls back into this api — passed as
# the `baseUrl` workflow input, then used for every /builds/:id/* request it makes.
# Must be internet-reachable from GitHub's hosted runners, so http://localhost:3011
# from this file's own DATABASE_URL-style defaults will NOT work here even in local
# dev — see the cloudflared-tunnel steps in the README for how to actually exercise a
# real workflow run against a local api. Unrelated to API_BASE_URL above: that one is
# only used for this api's own magic-link/OAuth-redirect URLs.
API_PUBLIC_URL=

# A fine-grained GitHub PAT (repo scope: Actions: write) used to call the
# workflow_dispatch REST API — see src/builds/github-actions-runner.ts. Only needed
# when BUILD_RUNNER=github.
GITHUB_DISPATCH_TOKEN=
# owner/repo this api dispatches the build-ipa.yml workflow against.
GITHUB_REPO=serob111/iosmobilio2
# Defaults match what's actually in .github/workflows/ — only override for a fork or a
# differently-named/branched workflow file.
GITHUB_WORKFLOW=build-ipa.yml
GITHUB_REF=main

# AES-256-GCM key (32 raw bytes, base64) GithubActionsRunner encrypts the one-off build
# token with before it goes into the workflow_dispatch input — workflow_dispatch inputs
# are visible in GitHub's own UI/audit trail, so the raw token must never be one of them.
# Generate with `openssl rand -base64 32`. The *same* value must also be set as the
# BUILD_TOKEN_KEY repository secret (Settings → Secrets and variables → Actions) —
# build-ipa.yml's "Decrypt build token" step uses it to recover the plaintext, right
# before masking it. Only needed when BUILD_RUNNER=github; the api refuses to start
# without it in that case (see validateBuildEnv in src/builds/validate-build-env.ts).
BUILD_TOKEN_KEY=
