# Points at the host-exposed ports from `docker compose up -d postgres redis` when running
# api natively (npm run dev). Inside docker-compose itself, api uses the internal
# postgres/redis hostnames instead (see docker-compose.yml) — this file is for local dev only.
DATABASE_URL=postgres://mobilio:mobilio@localhost:5433/mobilio
REDIS_URL=redis://localhost:6380
# Not 3000/3001 — this machine runs other, unrelated projects that occupy that range,
# and Next.js's automatic port fallback (when 3000 is taken) lands on 3001, which used
# to collide with this value.
PORT=3011

# Optional — leave unset to disable Sentry entirely (no-op).
SENTRY_DSN=
