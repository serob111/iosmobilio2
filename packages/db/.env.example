# Only needed to run `npm run db:migrate` natively against the Postgres started by
# `npm run dev:infra` (docker-compose's host-exposed port, see root .env.example). Copy
# to `.env` in this directory. Not needed in CI/docker-compose itself — there these are
# injected directly as container/job environment.

# Cluster bootstrap superuser (docker-compose's POSTGRES_USER/PASSWORD) — only used
# once, to create the two roles below if they don't exist yet.
POSTGRES_BOOTSTRAP_URL=postgres://mobilio:mobilio@localhost:5433/mobilio

# Fixed local-dev passwords for the two roles RLS depends on (see
# sql/0000_bootstrap_roles.sql). Not real secrets — ephemeral local/CI Postgres only.
MOBILIO_MIGRATOR_PASSWORD=mobilio_migrator_pw
MOBILIO_APP_PASSWORD=mobilio_app_pw

# mobilio_migrator's own connection string, used to run the actual table/RLS migrations
# once the role above exists.
MIGRATOR_DATABASE_URL=postgres://mobilio_migrator:mobilio_migrator_pw@localhost:5433/mobilio
